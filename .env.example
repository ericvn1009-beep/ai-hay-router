# Server
PORT=3000
LOG_LEVEL=info

# Auth
AIHAY_DEV_KEY=sk-aihay-dev-local
AIHAY_KEY_PEPPER=change-me-in-production

# Store: auto | memory | postgres
STORE_DRIVER=auto
DATABASE_URL=postgres://aihay:aihay@localhost:5432/aihay
REDIS_URL=redis://localhost:6379

# Provider platform keys (required for live inference)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Limits
REQUEST_TIMEOUT_MS=120000
DEFAULT_MAX_TOKENS=4096
DEFAULT_RPM=60
MAX_ATTEMPTS=3
