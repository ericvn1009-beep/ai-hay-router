# Server
PORT=3000
LOG_LEVEL=info

# Auth
AIHAY_DEV_KEY=sk-aihay-dev-local
AIHAY_KEY_PEPPER=change-me-in-production
SESSION_SECRET=dev-session-secret-change-me

# Store: auto | memory | postgres
STORE_DRIVER=auto
DATABASE_URL=postgres://aihay:aihay@localhost:5432/aihay
REDIS_URL=redis://localhost:6379

# Provider platform keys (required for live inference)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Limits
REQUEST_TIMEOUT_MS=120000
DEFAULT_MAX_TOKENS=4096
DEFAULT_RPM=60
MAX_ATTEMPTS=3

# Observability (V2.0) — defaults on for completion logs + metrics
SERVICE_NAME=aihay-api
# INSTANCE_ID=           # defaults to hostname
FEATURE_COMPLETION_LOGS=true
FEATURE_METRICS=true
FEATURE_OTEL=false
FEATURE_CONTROL_PLANE=true
FEATURE_ALIASES=true
FEATURE_BUDGETS=true
# BYOK off by default — set true + BYOK_MASTER_KEY in multi-tenant prod
FEATURE_BYOK=false
# 32-byte key as base64 or 64-char hex (required in production when FEATURE_BYOK=true)
# BYOK_MASTER_KEY=

# Credits (V2.6) — prepaid wallet for platform-path inference
FEATURE_CREDITS=false
# When true, workspaces with BYOK skip wallet pre-check/debit
CREDITS_BYOK_BYPASS=true
# Optional shared secret for POST /control/v1/webhooks/credits
# STRIPE_WEBHOOK_SECRET=

# Tools + vision (V2.7) — also requires model supports_tools / supports_vision
FEATURE_TOOLS_VISION=false

# Dashboard (apps/web) — server-side proxy target
# AIHAY_API_URL=http://127.0.0.1:3000

