{
  "name": "ai-hay-router",
  "private": true,
  "version": "0.8.0",
  "description": "AI Hay Router — unified multi-model LLM API",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @aihay/api dev",
    "dev:web": "pnpm --filter @aihay/web dev",
    "dev:full": "pnpm --filter @aihay/api dev & pnpm --filter @aihay/web dev",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @aihay/api build",
    "build:web": "pnpm --filter @aihay/web build",
    "start": "pnpm --filter @aihay/api start",
    "start:web": "pnpm --filter @aihay/web start",
    "test": "pnpm --filter @aihay/api test",
    "typecheck": "pnpm -r typecheck",
    "spike:chat": "pnpm --filter @aihay/api spike:chat",
    "aihay": "pnpm --filter @aihay/api keys",
    "keys": "pnpm --filter @aihay/api keys",
    "migrate": "pnpm --filter @aihay/api migrate",
    "smoke": "pnpm --filter @aihay/api smoke"
  }
}
