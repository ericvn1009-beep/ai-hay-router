{
  "name": "@aihay/api",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/db dist/migrations && cp src/db/schema.sql dist/db/schema.sql && cp models.yaml dist/models.yaml && cp -R migrations/. dist/migrations/",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "spike:chat": "tsx src/scripts/spike-chat.ts",
    "keys": "tsx src/scripts/keys.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "smoke": "tsx src/scripts/smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.8.5",
    "ioredis": "^6.0.0",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.20.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
